// Public client configuration. The local override is never committed.
UFIT_API_BASE_URL = http:/$()/127.0.0.1:4013
SUPABASE_URL =
SUPABASE_PUBLIC_KEY =
STRIPE_PUBLIC_KEY =
// Register the matching Apple merchant/certificate and signing entitlement before enabling Apple Pay.
UFIT_APPLE_PAY_MERCHANT_ID =
UFIT_APPLE_PAY_MERCHANT_COUNTRY_CODE =
#include? "UFit.local.xcconfig"
INFOPLIST_KEY_UFIT_API_BASE_URL = $(UFIT_API_BASE_URL)
INFOPLIST_KEY_SUPABASE_URL = $(SUPABASE_URL)
INFOPLIST_KEY_SUPABASE_PUBLIC_KEY = $(SUPABASE_PUBLIC_KEY)
INFOPLIST_KEY_STRIPE_PUBLIC_KEY = $(STRIPE_PUBLIC_KEY)
INFOPLIST_KEY_UFIT_APPLE_PAY_MERCHANT_ID = $(UFIT_APPLE_PAY_MERCHANT_ID)
INFOPLIST_KEY_UFIT_APPLE_PAY_MERCHANT_COUNTRY_CODE = $(UFIT_APPLE_PAY_MERCHANT_COUNTRY_CODE)
